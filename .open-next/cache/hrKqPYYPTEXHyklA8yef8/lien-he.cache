{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/lien-he/layout,_N_T_/lien-he/page,_N_T_/lien-he"},"segmentPaths":["/_tree","/_full","/lien-he/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0uyqu1yx8wyk6.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/0y-dctk-kmqss.js\" async=\"\"></script><script src=\"/_next/static/chunks/1k__zuwipnzw8.js\" async=\"\"></script><script src=\"/_next/static/chunks/3ewp08ebnb49j.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-1hriimvrri4sd.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\"></script><title>Create Next App</title><meta name=\"description\" content=\"Generated by create next app\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-white\"><section class=\"bg-slate-950 px-6 py-24 text-white\"><div class=\"mx-auto max-w-6xl text-center\"><span class=\"inline-block rounded-full bg-emerald-600/20 px-4 py-2 text-sm font-bold text-emerald-400\">LIÊN HỆ</span><h1 class=\"mt-6 text-4xl font-bold md:text-6xl\">Liên hệ với chúng tôi</h1><p class=\"mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300\">Nếu bạn cần thêm thông tin về giải pháp quản lý doanh nghiệp, hãy liên hệ với chúng tôi để được hỗ trợ.</p></div></section><section class=\"px-6 py-20\"><div class=\"mx-auto grid max-w-6xl gap-12 lg:grid-cols-2\"><div><p class=\"font-bold uppercase tracking-wider text-emerald-600\">THÔNG TIN LIÊN HỆ</p><h2 class=\"mt-3 text-3xl font-bold text-slate-950\">Chúng tôi sẵn sàng hỗ trợ</h2><p class=\"mt-5 leading-8 text-slate-600\">Liên hệ với chúng tôi để tìm hiểu thêm về hệ thống quản lý và các giải pháp phù hợp với hoạt động của doanh nghiệp.</p><div class=\"mt-8 space-y-4\"><div class=\"rounded-xl border border-slate-200 bg-slate-50 p-5\"><p class=\"text-sm font-bold uppercase tracking-wide text-slate-500\">Doanh nghiệp</p><p class=\"mt-2 font-bold text-slate-950\">Công ty chế biến hạt điều</p></div><div class=\"rounded-xl border border-slate-200 bg-slate-50 p-5\"><p class=\"text-sm font-bold uppercase tracking-wide text-slate-500\">Địa chỉ</p><p class=\"mt-2 font-bold text-slate-950\">Việt Nam</p></div><div class=\"rounded-xl border border-slate-200 bg-slate-50 p-5\"><p class=\"text-sm font-bold uppercase tracking-wide text-slate-500\">Điện thoại</p><p class=\"mt-2 font-bold text-slate-950\">0123 456 789</p></div><div class=\"rounded-xl border border-slate-200 bg-slate-50 p-5\"><p class=\"text-sm font-bold uppercase tracking-wide text-slate-500\">Email</p><p class=\"mt-2 font-bold text-slate-950\">contact@example.com</p></div></div></div><div class=\"rounded-2xl border border-slate-200 bg-white p-8 shadow-lg\"><h2 class=\"text-2xl font-bold text-slate-950\">Gửi yêu cầu liên hệ</h2><p class=\"mt-2 text-slate-600\">Vui lòng điền thông tin bên dưới.</p><form class=\"mt-8 space-y-5\"><div><label for=\"name\" class=\"mb-2 block text-sm font-bold text-slate-900\">Họ và tên</label><input id=\"name\" type=\"text\" placeholder=\"Nhập họ và tên\" class=\"w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-500 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-200\" name=\"name\"/></div><div><label for=\"email\" class=\"mb-2 block text-sm font-bold text-slate-900\">Email</label><input id=\"email\" type=\"email\" placeholder=\"example@email.com\" class=\"w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-500 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-200\" name=\"email\"/></div><div><label for=\"phone\" class=\"mb-2 block text-sm font-bold text-slate-900\">Số điện thoại</label><input id=\"phone\" type=\"tel\" placeholder=\"Nhập số điện thoại\" class=\"w-full rounded-lg border border-slate-300 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-500 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-200\" name=\"phone\"/></div><div><label for=\"message\" class=\"mb-2 block text-sm font-bold text-slate-900\">Nội dung</label><textarea id=\"message\" name=\"message\" rows=\"6\" placeholder=\"Nhập nội dung cần liên hệ...\" class=\"w-full resize-none rounded-lg border border-slate-300 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-500 focus:border-emerald-600 focus:ring-2 focus:ring-emerald-200\"></textarea></div><button type=\"submit\" class=\"w-full rounded-lg bg-emerald-600 px-6 py-3 font-bold text-white transition hover:bg-emerald-700\">Gửi liên hệ</button><p class=\"text-center text-xs text-slate-500\">Biểu mẫu hiện chỉ là giao diện minh họa.</p></form></div></div></section><section class=\"bg-slate-100 px-6 py-20\"><div class=\"mx-auto max-w-6xl\"><div class=\"rounded-2xl border border-slate-200 bg-white p-8\"><div class=\"flex min-h-[280px] items-center justify-c